# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Node / SvelteKit
node_modules/
.svelte-kit/
/ui/build/
/ui/.env
/ui/.env.*
!/ui/.env.example

# Copy of ui/build app.py looks for when running unfrozen (see
# rivulets.app._static_dir) — dev-only convenience, never committed
/server/src/rivulets/static/

# Rivulets runtime data (never commit user workspace data)
.rivulets/

# Packaging output
packaging/dist/
*.spec.bak

# Auto-generated by the claude-mem plugin — empty placeholders, not project content
docs/*/CLAUDE.md

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Playwright MCP tool session artifacts (screenshots, console logs)
.playwright-mcp/

# Env
.env
.env.local
